import plotly.graph_objects as go
import numpy as np

def generate_t_space_simulation():
    # Настройки
    n_branches = 15  # Количество квантовых веток (Axis Y)
    steps = 100      # Длина по оси времени (Axis X)
    
    fig = go.Figure()

    # 1. Визуализация Trunk (Axis X) - Сплошная линия истории
    x_trunk = np.linspace(0, steps, steps)
    y_trunk = np.zeros(steps)
    z_trunk = np.zeros(steps)
    
    fig.add_trace(go.Scatter3d(
        x=x_trunk, y=y_trunk, z=z_trunk,
        mode='lines',
        line=dict(color='brown', width=8),
        name='The Trunk (Linear Time)'
    ))

    # 2. Визуализация Roots (Axis Z) - Уход в причинную глубину
    for i in range(5):
        z_root = np.linspace(0, -20, 50)
        x_root = np.random.normal(0, 2, 50)
        fig.add_trace(go.Scatter3d(
            x=x_root, y=y_trunk[:50], z=z_root,
            mode='lines',
            line=dict(color='darkgreen', width=4, dash='dash'),
            name='The Roots (Causal Depth)',
            showlegend=False
        ))

    # 3. Визуализация Branches (Axis Y) - Квантовые вероятности
    # Используем случайное блуждание для симуляции "What If"
    for i in range(n_branches):
        y_branch = np.cumsum(np.random.randn(steps) * 0.5)
        z_branch = np.random.randn(steps) * 0.2 # Небольшие колебания по Z
        
        # Цвет ветки зависит от её "удаленности" (энтропия)
        color = 'rgba(255, 20, 147, ' + str(np.random.uniform(0.3, 0.8)) + ')'
        
        fig.add_trace(go.Scatter3d(
            x=x_trunk, y=y_branch, z=z_branch,
            mode='lines',
            line=dict(color=color, width=3),
            name=f'Branch {i+1} (Probabilities)'
        ))

    # Настройка осей и дизайна
    fig.update_layout(
        title="T-Space Theory: 5D Fractal Manifold Simulation",
        scene=dict(
            xaxis_title='Axis X: Linear Time',
            yaxis_title='Axis Y: Probability',
            zaxis_title='Axis Z: Causal Depth',
            bgcolor="black"
        ),
        margin=dict(l=0, r=0, b=0, t=40),
        template="plotly_dark"
    )

    fig.show()

# Запуск
generate_t_space_simulation()
